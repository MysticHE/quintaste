{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8086"
      ],
      "env": {
        "CI": "1"
      },
      "port": 8086
    },
    {
      "name": "expo-web-watch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--offline",
        "--port",
        "8089"
      ],
      "env": {
        "BROWSER": "none"
      },
      "port": 8089
    },
    {
      "name": "expo-web-auth",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--clear",
        "--port",
        "8088"
      ],
      "env": {
        "CI": "1",
        "EXPO_PUBLIC_AUTH_ENABLED": "true"
      },
      "port": 8088
    },
    {
      "name": "expo-web-ops",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.local/community-dev/dev.env",
        "node_modules/expo/bin/cli",
        "start",
        "--web",
        "--port",
        "8087"
      ],
      "env": {
        "CI": "1"
      },
      "port": 8087
    },
    {
      "name": "local-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.local/community-dev/dev.env",
        "server/index.mjs"
      ],
      "env": {
        "PORT": "18948",
        "APP_URL": "http://localhost:18948"
      },
      "port": 18948
    },
    {
      "name": "rh-harness",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "serve.mjs"
      ],
      "cwd": ".local/rh-harness",
      "port": 8099
    },
    {
      "name": "admin-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".local/admin-dev/start.mjs"
      ],
      "port": 3100
    },
    {
      "name": "expo-go",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--go",
        "--lan",
        "--port",
        "8083"
      ],
      "env": {
        "CI": "1"
      },
      "port": 8083
    }
  ]
}
