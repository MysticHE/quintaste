{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8086"],
      "env": { "CI": "1" },
      "port": 8086
    },
    {
      "name": "local-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.local/community-dev/dev.env", "server/index.mjs"],
      "env": { "PORT": "18948", "APP_URL": "http://localhost:18948" },
      "port": 18948
    }
  ]
}
