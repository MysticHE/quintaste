# Server/collector only. Never prefix this key with EXPO_PUBLIC_.
GOOGLE_PLACES_API_KEY=your_private_google_places_key
GOOGLE_CLOUD_PROJECT_ID=quintaste
# Live API routes use the Expo development-server origin in Expo Go.
# Production requires a deployed, protected API server and native SDK keys
# restricted separately to Android package/SHA-1 and iOS bundle identifier.

# Optional animated-avatar development pilot. Server only; never EXPO_PUBLIC_.
OPENAI_API_KEY=
AVATAR_ENABLED=false
AVATAR_IMAGE_MODEL=gpt-image-2.5-sunburst
AVATAR_ALLOWED_OWNERS=
# See docs/AVATAR_SETUP.md for device approval, HTTPS and production gates.
